    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  // Merge hone ki wajah se fields kabhi-kabhi JSON ke andar ya root par hoti hain, unhein handle kar rahe hain\n  const data = item.json;\n  const dep = data.Department || data.Department_1 || \"Unknown\";\n  \n  const budget = Number(data.Budget || 0);\n  const actual = Number(data.Actual || 0);\n  \n  // Variance Calculations\n  const varianceAmt = actual - budget;\n  const variancePct = budget !== 0 ? ((varianceAmt / budget) * 100).toFixed(2) : \"0.00\";\n  const status = varianceAmt > 0 ? \"Over Budget\" : \"Under Budget\";\n\n  return {\n    json: {\n      Department: dep,\n      Budget: budget,\n      Actual: actual,\n      VarianceAmount: varianceAmt,\n      VariancePercentage: `${variancePct}%`,\n      Status: status,\n      IsOverBudget: varianceAmt > 0\n    }\n  };\n});"
      },
